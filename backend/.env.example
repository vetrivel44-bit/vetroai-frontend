PORT=3000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1400

# Web search (Tavily primary, DuckDuckGo fallback with no key needed).
# Without this, search-dependent modes (web_search, deep_search, research) fall
# back to DDG or answer without live results — see searchController.js.
TAVILY_API_KEY=your_tavily_api_key_here

# Model that plans and critiques the DeepSearch/research agentic search loop
# (see agenticSearchService.js). Small and fast on purpose: it writes queries
# and judges coverage, not the final answer. Uses GROQ_API_KEY above to call
# it — without GROQ_API_KEY set, the loop degrades to a single non-iterating
# search rather than failing.
SEARCH_PLANNER_MODEL=llama-3.1-8b-instant
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-1
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=8192
# RapidAPI key shared by the ChatGPT provider, Vision API, AI Doctor API, and TTS proxy
CHATGPT_API_KEY=your_rapidapi_key_here

# Claude Fable 5 RapidAPI (server-side only; falls back to CHATGPT_API_KEY when blank)
# Prefer a newly rotated key and never expose it in Vite/frontend variables.
FABLE_RAPIDAPI_KEY=
FABLE_API_HOST=claude-fable-5-api.p.rapidapi.com
FABLE_API_URL=https://claude-fable-5-api.p.rapidapi.com/n9zkopuh8fn4eqyi5xy5bqr3tt66mkt3
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
# Cohere — universal last-resort fallback. Tried after every other configured
# provider above has failed or run out of credits (see ProviderManager
# fallbacks). Uses Cohere's OpenAI-compatible endpoint.
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
# Used automatically when a request carries an image, so computer mode's
# screen-control agent can fall back to Cohere and still see the screenshot.
COHERE_VISION_MODEL=command-a-vision-07-2025
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# ── Plugsky (OpenAI-compatible gateway) ───────────────────────────────────────
# Server-side only — never expose this in a VITE_ variable. Reasoning-capable
# models here stream native thinking tokens into the UI's thinking panel.
PLUGSKY_API_KEY=your_plugsky_api_key_here
PLUGSKY_BASE_URL=https://api.plugsky.com/v1
PLUGSKY_MODEL=plugsky-pro
PLUGSKY_TEMPERATURE=0.7
PLUGSKY_MAX_TOKENS=8192

# ── Streamed thinking panel ───────────────────────────────────────────────────
# Set to false to stop asking models for a <think> block (native reasoning
# tokens from providers that emit them are still streamed).
THINKING_ENABLED=true
# ── Chess Arena — dedicated keys, isolated from the main chat providers above.
# These power AI vs AI / Spectator / Player vs AI moves only; leaving any of
# them blank just makes that model fall back to a random legal move.
CHESS_MISTRAL_API_KEY=
CHESS_MISTRAL_MODEL=mistral-small-latest
CHESS_GROQ_API_KEY=
CHESS_GROQ_MODEL=llama-3.3-70b-versatile
CHESS_GEMINI_API_KEY=
CHESS_GEMINI_MODEL=gemini-3.6-flash
CHESS_OPENROUTER_API_KEY=
CHESS_OPENROUTER_MODEL=openai/gpt-4o-mini

# News feed. Works with currentsapi.services, newsdata.io, thenewsapi.com or
# newsapi.org — the service is detected from the key's shape, so normally only
# the key is needed. NEWSDATA_API_KEY is the old name and still works.
NEWS_API_KEY=your_news_api_key_here
# Optional override when detection guesses wrong, which it can between
# thenewsapi (40-char tokens) and currents (longer ones):
# currents | newsdata | thenewsapi | newsapi
NEWS_PROVIDER=currents
# Optional articles-per-request cap. thenewsapi.com rejects a limit above its
# plan ceiling (3 on the free tier) and currents caps page_size per plan too, so
# leave it empty to use the plan default.
NEWS_API_LIMIT=
API_SPORTS_KEY=your_api_sports_key_here

# ── ProKerala (Vedic astrology: kundli, planet positions, dasha periods) ──────
# OAuth2 client-credentials app from https://api.prokerala.com/
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
ENABLE_CLOUD_SESSIONS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886
BOOKING_NOTIFICATION_PHONES=8778508652,9994777865

# ── Persistent accounts (required for billing/credits to survive a restart) ──
# Leave unset to keep running in offline/in-memory auth mode.
MONGO_URI=

# Used to build Stripe success/cancel/portal redirect URLs.
FRONTEND_URL=http://localhost:5174

# ── Stripe billing (leave unset to keep "Upgrade plan" UI visible but disabled) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# ── Voice Cover ───────────────────────────────────────────────────────────────
# Keep provider secrets server-side. The frontend uses Puter.js only for the
# documented speech2speech step after vocals have been separated.
# Stem separator: hosted Demucs/UVR-compatible worker/service.
AUDIO_SEPARATOR_URL=
AUDIO_SEPARATOR_KEY=
# FFmpeg/media worker that accepts instrumental + converted vocal URLs and returns
# an encoded MP3/WAV URL.
AUDIO_MIXER_URL=
AUDIO_MIXER_KEY=
# Authorized custom voice creation provider. Must return a target voice ID that
# can be used by the configured speech-to-speech provider.
VOICE_PROFILE_PROVIDER_URL=
VOICE_PROFILE_PROVIDER_KEY=
