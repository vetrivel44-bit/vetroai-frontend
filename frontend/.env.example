# Copy to .env.local and fill in. Vite exposes only vars prefixed with VITE_.

VITE_API_BASE_URL=http://localhost:3000
# For public deployment, change VITE_API_BASE_URL to your public backend URL (e.g. https://api.yourdomain.com)

# ── Firebase ──────────────────────────────────────────────────────────────────
# Authentication (Google Sign-in + email/password) and Firestore.
#
# These are not secrets. Google documents the web config as publicly shippable —
# what protects the project is firestore.rules plus the Authentication
# "Authorized domains" list, both of which live in this repo's root.
#
# Fetch the real values for the `vetroai` project with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project vetroai
#
# apiKey and appId are required; the rest fall back to the `vetroai` defaults
# baked into src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_AUTH_DOMAIN=vetroai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vetroai
VITE_FIREBASE_STORAGE_BUCKET=vetroai.firebasestorage.app

# MapTiler browser key. Configure allowed HTTP origins in MapTiler before production use.
VITE_MAPTILER_KEY=your_maptiler_key_here
