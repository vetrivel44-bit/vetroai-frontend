# Copy to .env.local and fill in. Vite exposes only vars prefixed with VITE_.

VITE_API_BASE_URL=http://localhost:3000
# For public deployment, change VITE_API_BASE_URL to your public backend URL (e.g. https://api.yourdomain.com)

# ── Firebase ──────────────────────────────────────────────────────────────────
# Authentication (Google Sign-in + email/password) and Firestore.
#
# You do NOT need to set these. The `vetroai` web app config is baked into
# src/firebase.js as the default, so a plain `npm run build` just works.
#
# Set them only to point a build at a different Firebase project — all six must
# then be provided together. They are not secrets: Google ships the web config
# in every client bundle by design. What protects the project is firestore.rules
# plus the Authentication "Authorized domains" list.
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MEASUREMENT_ID=

# App Check (optional). Attests that requests come from your real app, so
# someone who lifts the API key out of the bundle cannot drive Auth and
# Firestore with it. Inert until set. Register the web app under
# Firebase Console -> App Check with reCAPTCHA v3 and paste the site key here.
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# MapTiler browser key. Configure allowed HTTP origins in MapTiler before production use.
VITE_MAPTILER_KEY=your_maptiler_key_here

# ── Puter.js shared account ───────────────────────────────────────────────────
# Optional. Without this, Puter.js asks each visitor to use their own Puter
# account. With it, every visitor's Puter usage (GPT/Codex/DeepSeek/Grok,
# Gemini, Sonar research) runs on THIS one account and its credits.
# WARNING: it ships inside the public frontend bundle, so anyone can read it
# from dev tools and spend this account's credits outside the app. Rotate it
# from your Puter account if you see abuse.
VITE_PUTER_AUTH_TOKEN=
