rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Every document below lives under the signed-in user's own uid, so the whole
// ruleset reduces to one idea: you may only touch your own subtree.
//
// Collection: users
// Document ID: the Firebase Auth uid
// Fields:
//   - uid: string (required, immutable, must equal request.auth.uid)
//   - email: string (required)
//   - name: string (optional)
//   - picture: string (optional)
//   - createdAt: timestamp (set once on first sign-in)
//   - lastLoginAt: timestamp (refreshed on every sign-in)
//
// Collection: users/{uid}/sessions
// Document ID: client-generated `${Date.now()}_${random}`
// Fields:
//   - id: string (required, must match the document id)
//   - title: string (optional)
//   - messages: list (optional) - the conversation turns
//   - spaceId: string | null (optional) - owning project
//   - updatedAt: timestamp (server-set)
//
// Collection: users/{uid}/spaces
// Document ID: client-generated
// Fields:
//   - id: string (required, must match the document id)
//   - name: string (optional)
//   - mode / systemPrompt / etc: caller-defined, shape evolves with the UI
//   - updatedAt: timestamp (server-set)
//
// Collection: users/{uid}/artifacts
// Document ID: client-generated
// Fields:
//   - id: string (required, must match the document id)
//   - code: string (optional)
//   - language: string (optional)
//   - title: string (optional)
//   - createdAt: number (client epoch ms)
//   - updatedAt: timestamp (server-set)
//
// Collection: users/{uid}/memories
// Document ID: client-generated
// Fields:
//   - id: string (required, must match the document id)
//   - text: string (required) - the fact to remember
//   - createdAt: number (client epoch ms)
//   - source: string (optional) - "manual" | "chat"
//   - updatedAt: timestamp (server-set)
//
// Collection: users/{uid}/dispatch  (Computer → Dispatch)
// Document ID: client-generated `d_${Date.now()}_${random}`
// Fields:
//   - id: string (required, must match the document id)
//   - text: string (required, 1-4000 chars, fixed once sent) - the task
//   - status: string (required) - queued | awaiting_approval | claimed |
//             running | done | failed | cancelled
//   - target: string (optional) - a device id, or "any"
//   - claimedBy / progress / result / error: written back by the computer
//   - createdAt / updatedAt: number (client epoch ms)
//
// Collection: users/{uid}/devices  (computers that accept Dispatch tasks)
// Document ID: client-generated device id
// Fields:
//   - id: string (required, must match the document id)
//   - name: string (required, <= 60 chars)
//   - accepting: bool, busy: bool, lastSeen: number (client epoch ms)
//
// Collection: users/{uid}/prefs
// Document ID: "app"
// Fields:
//   - current_space: string | null (optional)
//   - updatedAt: timestamp (server-set)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // Helper Functions
    // =============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // An email + password account must have confirmed its address before it
    // can store anything. Google sign-ins arrive with email_verified = true.
    function hasVerifiedEmail() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider != 'password';
    }

    // Ownership is positional: the uid is a path segment, so there is no
    // document read needed to authorise a request.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId && hasVerifiedEmail();
    }

    function incoming() {
      return request.resource.data;
    }

    // The `id` field is what the client keys its React state off, so a document
    // whose id disagrees with its path would silently corrupt that state.
    function idMatchesPath(docId) {
      return !('id' in incoming()) || incoming().id == docId;
    }

    // A single Firestore document is capped at 1 MiB. Rejecting oversized
    // writes here turns a confusing partial failure into a clear denial.
    function withinSizeLimit() {
      return request.resource.size() < 1048576;
    }

    function isValidUserProfile(userId) {
      return incoming().uid is string
        && incoming().uid == userId
        && incoming().email is string
        && (!('name' in incoming())    || incoming().name is string)
        && (!('picture' in incoming()) || incoming().picture is string);
    }

    // uid identifies the owner; letting it change would hand the document to
    // someone else.
    function uidUnchanged() {
      return !('uid' in incoming()) || incoming().uid == resource.data.uid;
    }

    // =============================================================
    // Rules
    // =============================================================

    // --- User profile ---
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidUserProfile(userId)
                    && withinSizeLimit();
      allow update: if isOwner(userId)
                    && isValidUserProfile(userId)
                    && uidUnchanged()
                    && withinSizeLimit();
      allow delete: if isOwner(userId);

      // --- Chat conversations ---
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && idMatchesPath(sessionId)
                              && (!('messages' in incoming()) || incoming().messages is list)
                              && (!('title' in incoming())    || incoming().title is string)
                              && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      // --- Projects / spaces ---
      match /spaces/{spaceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && idMatchesPath(spaceId)
                              && (!('name' in incoming()) || incoming().name is string)
                              && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      // --- Saved artifacts ---
      match /artifacts/{artifactId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && idMatchesPath(artifactId)
                              && (!('code' in incoming())     || incoming().code is string)
                              && (!('language' in incoming()) || incoming().language is string)
                              && (!('title' in incoming())    || incoming().title is string)
                              && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      // --- Remembered facts, injected into the system prompt ---
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && idMatchesPath(memoryId)
                              && incoming().text is string
                              && incoming().text.size() > 0
                              && incoming().text.size() <= 2000
                              && (!('source' in incoming()) || incoming().source is string)
                              && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      // --- Dispatch: tasks sent from the phone to the user's computer ---
      // Both ends are the same signed-in user, so ownership is the whole
      // check; the rest keeps the documents to the shape the app reads.
      function isValidDispatch() {
        return incoming().text is string
          && incoming().text.size() > 0
          && incoming().text.size() <= 4000
          && incoming().status in ['queued', 'awaiting_approval', 'claimed', 'running', 'done', 'failed', 'cancelled']
          && (!('result' in incoming()) || (incoming().result is string && incoming().result.size() <= 20000))
          && (!('error' in incoming())  || (incoming().error is string && incoming().error.size() <= 2000));
      }
      match /dispatch/{dispatchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && idMatchesPath(dispatchId)
                      && isValidDispatch()
                      && withinSizeLimit();
        allow update: if isOwner(userId)
                      && idMatchesPath(dispatchId)
                      && isValidDispatch()
                      && incoming().text == resource.data.text
                      && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && idMatchesPath(deviceId)
                              && incoming().name is string
                              && incoming().name.size() <= 60
                              && withinSizeLimit();
        allow delete: if isOwner(userId);
      }

      // --- Small scalar preferences ---
      // Split rather than a blanket `write`: on a delete there is no
      // request.resource, so withinSizeLimit() evaluates against null and
      // denies. That made the owner's own prefs document undeletable.
      match /prefs/{prefId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && withinSizeLimit();
        allow delete: if isOwner(userId);
      }
    }

    // --- Published websites (VetroAI Computer → Publish) ---
    // Anyone with the link can open one (/s/{siteId}); nobody can list them.
    // Only a signed-in owner can create, change or remove their own.
    function isValidSite() {
      return incoming().owner is string
        && incoming().html is string
        && incoming().html.size() <= 900000
        && (!('title' in incoming()) || (incoming().title is string && incoming().title.size() <= 120));
    }

    match /sites/{siteId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && hasVerifiedEmail()
                    && siteId.size() <= 48
                    && incoming().owner == request.auth.uid
                    && isValidSite() && withinSizeLimit();
      allow update: if isAuthenticated() && resource.data.owner == request.auth.uid
                    && incoming().owner == request.auth.uid
                    && isValidSite() && withinSizeLimit();
      allow delete: if isAuthenticated() && resource.data.owner == request.auth.uid;
    }

    // Default deny. Any path not matched above is unreachable, for every user,
    // authenticated or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
